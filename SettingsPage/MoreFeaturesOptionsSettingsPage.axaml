<ci:SettingsPageBase x:Class="SystemTools.MoreFeaturesOptionsSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE5CB;}"
                                       Header="自动切换 ClassIsland 主题"
                                       Description="每两秒检测主界面所覆盖位置背后的画面；颜色偏暗时切换为黑暗主题，偏亮时切换为明亮主题。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.AutoSwitchClassIslandTheme, Mode=TwoWay}"
                                  IsCheckedChanged="AutoMatchThemeToggle_OnChanged" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEEE3;}"
                                       Header="主界面遮挡文字时"
                                       Description="每两秒检测主界面所覆盖位置背后的文字；识别到至少 4 个文字字符时隐藏主界面，否则显示主界面。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.AutoHideMainWindowWhenOccluded, Mode=TwoWay}"
                                  IsCheckedChanged="AutoHideMainWindowOnTextToggle_OnChanged" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEE81;}"
                                       Header="自动播放"
                                       Description="当插入U盘设备时时自动打开">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.AutoOpenUsbDriveOnInsert, Mode=TwoWay}"
                                  IsCheckedChanged="AutoOpenUsbToggle_OnChanged" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE97B;}"
                                       Header="自动清理 ClassIsland 内存"
                                       Description="当软件内存占用超过 500MB 时自动执行垃圾回收与工作集修剪。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.AutoCleanupClassIslandMemory, Mode=TwoWay}"
                                  IsCheckedChanged="AutoCleanupMemoryToggle_OnChanged" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEE21;}"
                                       Header="自动清理内存（管理员）"
                                       Description="清理低优先级待机列表、注册表缓存、工作集和系统文件缓存；可能造成短暂卡顿。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.AutoCleanupSystemMemory, Mode=TwoWay}"
                                  Click="AutoCleanupSystemMemoryToggle_OnClick" />
                </controls:FASettingsExpander.Footer>

                <controls:FASettingsExpanderItem Content="自动清理阈值"
                                                 Description="可设置 50%–99%（默认 90%）；达到阈值时触发一次，明显回落后才会再次触发。">
                    <controls:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown Width="140"
                                           Minimum="50"
                                           Maximum="99"
                                           Increment="1"
                                           FormatString="F0"
                                           Value="{Binding Config.SystemMemoryCleanupThresholdPercent, Mode=TwoWay}" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="立即清理"
                                                 Description="无需开启自动清理，也可以手动执行上述四种清理方法。">
                    <controls:FASettingsExpanderItem.Footer>
                        <Button Content="一键清理"
                                Width="165"
                                Click="CleanSystemMemoryNow_OnClick" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF005;}"
                                         Header="AI 服务"
                                         Description="配置兼容 OpenAI 格式的 AI 服务，供插件功能调用。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.EnableAiService, Mode=OneWay}"
                                  Click="AiServiceToggle_OnClick" />
                </controls:FASettingsExpander.Footer>

                <controls:FASettingsExpanderItem Content="供应商名称"
                                                 Description="用于标识当前配置的 AI 服务供应商。"
                                                 IsEnabled="{Binding Config.EnableAiService}">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox Width="300"
                                 PlaceholderText="OpenAI"
                                 Text="{Binding Config.AiProviderName, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="API Key"
                                                 Description="请求服务时使用的 Bearer API 密钥。"
                                                 IsEnabled="{Binding Config.EnableAiService}">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox Width="300"
                                 PasswordChar="*"
                                 PlaceholderText="sk-..."
                                 Text="{Binding Config.AiApiKey, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="API 请求地址"
                                                 Description="兼容 OpenAI 的 API 基址，例如 https://api.openai.com/v1。"
                                                 IsEnabled="{Binding Config.EnableAiService}">
                    <controls:FASettingsExpanderItem.Footer>
                        <TextBox Width="300"
                                 PlaceholderText="https://api.openai.com/v1"
                                 Text="{Binding Config.AiApiUrl, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>

                <controls:FASettingsExpanderItem Content="模型"
                                                 Description="从供应商获取可用模型并选择默认模型。"
                                                 IsEnabled="{Binding Config.EnableAiService}">
                    <controls:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="200"
                                      ItemsSource="{Binding AvailableAiModels}"
                                      SelectedItem="{Binding Config.AiModel, Mode=TwoWay}"
                                      PlaceholderText="请先获取模型" />
                            <Button Width="92"
                                    Content="获取模型"
                                    Click="GetAiModelsButton_OnClick" />
                        </StackPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
