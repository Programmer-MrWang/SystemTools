<ci:MyWindow x:Class="SystemTools.Views.ProfileExcelExportDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             Width="580"
             SizeToContent="Height"
             WindowStartupLocation="CenterOwner"
             CanResize="False"
             Title="SystemTools - 导出课程档案为 Excel 表格"
             ShowAsDialog="True">

    <Border Padding="16" CornerRadius="8"
            Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <ci:FluentIcon Glyph="&#xE743;" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="导出课程档案为 Excel 表格" FontSize="19.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="ProfileNameTextBlockElement"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Border Grid.Row="2" Padding="14" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="要导出的内容（可多选）" FontWeight="SemiBold" />
                    <CheckBox x:Name="ClassPlanCheckBoxElement"
                              Content="课表"
                              IsCheckedChanged="ExportTargetCheckBox_OnChanged" />
                    <CheckBox x:Name="TimeLayoutCheckBoxElement"
                              Content="时间表"
                              IsCheckedChanged="ExportTargetCheckBox_OnChanged" />
                    <CheckBox x:Name="SubjectCheckBoxElement"
                              Content="科目与教师"
                              IsCheckedChanged="ExportTargetCheckBox_OnChanged" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Spacing="10">
                <TextBlock Text="文件格式" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton x:Name="XlsxRadioButtonElement" GroupName="ExportFormat"
                                 Content="Excel 工作簿（.xlsx）" IsChecked="True" />
                    <RadioButton x:Name="XlsRadioButtonElement" GroupName="ExportFormat"
                                 Content="Excel 97-2003 工作簿（.xls）" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="4"
                    x:Name="StorageModePanelElement"
                    IsVisible="False"
                    Padding="14" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="导出方式" FontWeight="SemiBold" />
                    <RadioButton x:Name="SingleFileModeRadioButtonElement" GroupName="StorageMode"
                                 Content="单文件多表格（一个文件包含多个工作表）" IsChecked="True" />
                    <RadioButton x:Name="MultipleFilesModeRadioButtonElement" GroupName="StorageMode"
                                 Content="多文件（每项内容各存为一个文件）" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="MessageTextBlockElement"
                           Grid.Column="0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                <Button x:Name="CancelButtonElement"
                        Grid.Column="1"
                        Content="取消"
                        Height="33"
                        MinWidth="84"
                        Margin="0 0 8 0" />

                <Button x:Name="ExportButtonElement"
                        Grid.Column="2"
                        Content="导出"
                        Height="33"
                        MinWidth="110"
                        Classes="accent"
                        IsDefault="True" />
            </Grid>

        </Grid>
    </Border>
</ci:MyWindow>
