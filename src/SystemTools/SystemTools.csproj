<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1" ExcludeAssets="runtime;native" />
    <PackageReference Include="Avalonia" Version="12.1.4" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" ExcludeAssets="runtime;native" />
    <ProjectReference Include="../SystemTools.Contracts/SystemTools.Contracts.csproj" />
    <ProjectReference Include="../SystemTools.Common/SystemTools.Common.csproj" />
    <ProjectReference Include="../SystemTools.SharedHost/SystemTools.SharedHost.csproj" />
    <!-- Build only this machine's backend; never reference its types from the entrance. -->
    <ProjectReference Include="../SystemTools.Platforms.$(SystemToolsPlatform)/SystemTools.Platforms.$(SystemToolsPlatform).csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <None Include="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Remove="Compatibility/*.axaml" />
    <AvaloniaResource Include="Compatibility/CardTypeComponent.axaml" Link="Themes/CardTypeComponent/Styles.axaml" />
    <AvaloniaResource Include="Compatibility/ClassWidgets.axaml" Link="Themes/ClassWidgets/Styles.axaml" />
    <AvaloniaResource Include="Compatibility/NotchStyle.axaml" Link="Themes/NotchStyle/Styles.axaml" />
    <AvaloniaResource Include="Compatibility/SettingsPageLazy.axaml" Link="Controls/SettingsPageLazy.axaml" />
    <AvaloniaResource Include="../../Themes/**/*.axaml.txt" Link="Themes/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../Themes/**/*.png" Link="Themes/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../ThirdParty/**/*.sksl" Link="ThirdParty/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CheckPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SystemToolsPlatform)' != 'Windows' and '$(SystemToolsPlatform)' != 'Linux' and '$(SystemToolsPlatform)' != 'MacOS'" Text="Unsupported SystemToolsPlatform: $(SystemToolsPlatform)" />
  </Target>
  <Target Name="CopyLocalBackend" AfterTargets="Build">
    <PropertyGroup>
      <BackendFramework Condition="'$(SystemToolsPlatform)' == 'Windows'">net10.0-windows10.0.19041.0</BackendFramework>
      <BackendFramework Condition="'$(BackendFramework)' == ''">net10.0</BackendFramework>
      <BackendOutput>$(MSBuildProjectDirectory)/../SystemTools.Platforms.$(SystemToolsPlatform)/bin/$(Configuration)/$(BackendFramework)</BackendOutput>
    </PropertyGroup>
    <Copy SourceFiles="$(BackendOutput)/SystemTools.Platforms.$(SystemToolsPlatform).dll" DestinationFolder="$(TargetDir)" />
    <ItemGroup>
      <SharedPrivateFiles Include="$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/NPOI.*.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/Enums.NET.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/ExtendedNumerics.BigDecimal.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/MathNet.Numerics.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/SixLabors.*.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/SuperAutoIsland.Interface.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/ICSharpCode.SharpZipLib.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/Microsoft.IO.RecyclableMemoryStream.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/BouncyCastle.Cryptography.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/System.Security.Cryptography.Pkcs.dll;$(MSBuildProjectDirectory)/../SystemTools.SharedHost/bin/$(Configuration)/net10.0/System.Security.Cryptography.Xml.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedPrivateFiles)" DestinationFolder="$(TargetDir)platforms/shared" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(SystemToolsPlatform)' == 'Windows'">
      <!-- SDK/framework assemblies remain owned by the host; these are plugin-private dependencies. -->
      <WindowsPrivateFiles Include="$(BackendOutput)/DlibDotNet.dll;$(BackendOutput)/Enums.NET.dll;$(BackendOutput)/ExtendedNumerics.BigDecimal.dll;$(BackendOutput)/MathNet.Numerics.dll;$(BackendOutput)/NPOI.*.dll;$(BackendOutput)/OpenCvSharp*.dll;$(BackendOutput)/SixLabors.*.dll;$(BackendOutput)/SuperAutoIsland.Interface.dll" />
      <WindowsNativeFiles Include="$(BackendOutput)/runtimes/win-x64/native/DlibDotNet*.dll;$(BackendOutput)/runtimes/win-x64/native/OpenCvSharpExtern.dll;$(BackendOutput)/runtimes/win-x64/native/opencv_videoio_ffmpeg*.dll" />
      <WindowsWorkerFiles Include="$(MSBuildProjectDirectory)/../../VoskWorker/bin/$(Configuration)/net10.0/win-x64/**/*" />
      <WindowsContent Include="$(MSBuildProjectDirectory)/../../black.html;$(MSBuildProjectDirectory)/../../title.png;$(MSBuildProjectDirectory)/../../version.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsPrivateFiles)" DestinationFolder="$(TargetDir)platforms/win-x64" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WindowsNativeFiles)" DestinationFolder="$(TargetDir)platforms/win-x64/runtimes/win-x64/native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WindowsWorkerFiles)" DestinationFiles="@(WindowsWorkerFiles->'$(TargetDir)platforms/win-x64/VoskWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WindowsContent)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
