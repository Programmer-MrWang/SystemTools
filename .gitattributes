# Auto detect text files and perform LF normalization
* text=auto
# Keep shared source checksums stable across native build agents.
/src/** text eol=lf
/tests/** text eol=lf
/eng/*.py text eol=lf
/SystemTools.slnx text eol=lf
/global.json text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.axaml text eol=lf
*.axaml.txt text eol=lf
*.sksl text eol=lf
*.resx text eol=lf
/NativeMethods.txt text eol=lf

/eng/shared-host-sources.props text eol=lf
/eng/shared-host-sources.json text eol=lf
