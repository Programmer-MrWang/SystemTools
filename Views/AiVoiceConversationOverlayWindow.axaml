<Window x:Class="SystemTools.Views.AiVoiceConversationOverlayWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SystemTools.Views"
        Title="AI voice conversation"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        KeyDown="Window_OnKeyDown"
        Closing="Window_OnClosing">
    <Border x:Name="RootBorder"
            Padding="28,24,28,26"
            CornerRadius="22">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="18">
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="7">
                <TextBlock x:Name="TranscriptText"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           MaxWidth="720"
                           FontSize="20"
                           FontWeight="Medium"
                           LineHeight="29"
                           IsVisible="False" />
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="25"
                           FontWeight="SemiBold"
                           LetterSpacing="0.2" />
                <TextBlock x:Name="DetailText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="720"
                           FontSize="14"
                           Opacity="0.72"
                           IsVisible="False" />
            </StackPanel>

            <Border Grid.Row="1"
                    MinHeight="116"
                    CornerRadius="16"
                    Padding="10,8"
                    Background="#0063B100">
                <local:VoiceWaveformControl x:Name="Waveform"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
            </Border>
        </Grid>
    </Border>
</Window>
