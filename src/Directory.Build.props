<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/SystemTools</PathMap>
    <DebugType>embedded</DebugType>
    <!-- The solution intentionally contains only the entrance; preserve config for conditional references. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <Version>3.0.0</Version>
    <CreateCipx>false</CreateCipx>
    <SystemToolsPlatform Condition="'$(SystemToolsPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</SystemToolsPlatform>
    <SystemToolsPlatform Condition="'$(SystemToolsPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</SystemToolsPlatform>
    <SystemToolsPlatform Condition="'$(SystemToolsPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</SystemToolsPlatform>
  </PropertyGroup>
</Project>
