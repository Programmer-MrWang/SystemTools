<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SystemTools</RootNamespace>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 引用最终经过 XAML 编译的公共实现，避免中间引用程序集的 MVID 随宿主系统变化。 -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1" ExcludeAssets="runtime;native" />
    <PackageReference Include="Avalonia" Version="12.1.4" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" ExcludeAssets="runtime;native" />
    <PackageReference Include="NPOI" Version="2.7.2" />
    <PackageReference Include="SuperAutoIsland.Interface" Version="0.3.9.2-dev.3" />
    <ProjectReference Include="../SystemTools.Common/SystemTools.Common.csproj" />
  </ItemGroup>
  <Import Project="../../eng/shared-host-sources.props" />
  <ItemGroup><Compile Include="@(SharedHostSource)" /><AvaloniaXaml Include="@(SharedHostXaml)" /></ItemGroup>
</Project>
